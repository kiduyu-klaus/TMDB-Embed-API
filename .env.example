TMDB_API_KEY=your_tmdb_api_key
# Optional: JSON array for multi-key rotation
# TMDB_API_KEYS=["key1","key2"]
# Optional: server port (defaults to 8787)
# API_PORT=8787
# Optional: require ?token= on /api/streams/* endpoints (SHA-256 hex).
# Leave empty to keep stream endpoints open. Manage it from the admin UI:
# Config -> Keys -> "Stream API Token Password".
# STREAM_TOKEN_HASH=
# Optional: serve the app under a sub-path (reverse proxy / Plesk app root),
# e.g. MOUNT_PATH=/kiduyuTv_providers. Leave empty to serve from the domain root.
# MOUNT_PATH=/kiduyuTv_providers